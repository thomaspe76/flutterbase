# === FIREBASE ===
# Firebase configuration is managed via firebase_options.dart
# Run: flutterfire configure

# === ADMOB ===
# Test IDs are in the code, replace with production IDs here:
ADMOB_APP_ID_ANDROID=ca-app-pub-XXXXX~YYYYY
ADMOB_APP_ID_IOS=ca-app-pub-XXXXX~YYYYY
ADMOB_BANNER_ANDROID=ca-app-pub-XXXXX/YYYYY
ADMOB_BANNER_IOS=ca-app-pub-XXXXX/YYYYY
ADMOB_REWARDED_ANDROID=ca-app-pub-XXXXX/YYYYY
ADMOB_REWARDED_IOS=ca-app-pub-XXXXX/YYYYY
ADMOB_INTERSTITIAL_ANDROID=ca-app-pub-XXXXX/YYYYY
ADMOB_INTERSTITIAL_IOS=ca-app-pub-XXXXX/YYYYY

# === REVENUECAT ===
REVENUECAT_KEY_ANDROID=your_android_key
REVENUECAT_KEY_IOS=your_ios_key

# === DYNAMIC LINKS (iOS Referral) ===
DYNAMIC_LINK_DOMAIN=yourapp.page.link
IOS_BUNDLE_ID=com.company.app
IOS_APP_STORE_ID=123456789
ANDROID_PACKAGE_NAME=com.company.app

# === AI ===
GEMINI_API_KEY=your_gemini_api_key

# === SUPABASE (if used) ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
