# === APP CONFIG ===
ENVIRONMENT=dev
API_BASE_URL=https://api.example.com
ENABLE_LOGGING=true

# === SUPABASE ===
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key

# === FIREBASE ===
# Wird über firebase_options.dart konfiguriert

# === SENTRY ===
SENTRY_DSN=your_sentry_dsn

# === ADMOB ===
# Test-IDs sind im Code hardcoded, für Produktion hier eintragen:
ADMOB_ANDROID_APP_ID=ca-app-pub-XXXXX~YYYYY
ADMOB_IOS_APP_ID=ca-app-pub-XXXXX~YYYYY
ADMOB_BANNER_ANDROID=ca-app-pub-XXXXX/YYYYY
ADMOB_BANNER_IOS=ca-app-pub-XXXXX/YYYYY
ADMOB_REWARDED_ANDROID=ca-app-pub-XXXXX/YYYYY
ADMOB_REWARDED_IOS=ca-app-pub-XXXXX/YYYYY

# === REVENUECAT ===
REVENUECAT_ANDROID_KEY=your_android_key
REVENUECAT_IOS_KEY=your_ios_key

# === API KEYS ===
# Für KI-Features (Gemini, OpenAI, etc.)
AI_API_KEY=your_api_key_here
GEMINI_API_KEY=your_gemini_key
